# Copy to .env.docker and fill in real values before `docker compose up`.
# .env.docker is gitignored (see .gitignore) — never commit real secrets.
#
# DATABASE_URL, INNGEST_DEV, and INNGEST_BASE_URL are NOT set here — they're
# fixed service-to-service wiring hardcoded in docker-compose.yml (the app
# always talks to the `postgres` and `inngest` services by their compose
# hostnames). Only genuinely per-user secrets/config live in this file.

# GitHub OAuth app (repo scope) — same values you use for local `bun run dev`.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Baked into the client bundle at build time (see Dockerfile) — must match
# the docker-compose.yml `app.build.args.NEXT_PUBLIC_APP_BASE_URL` default,
# or be overridden via a NEXT_PUBLIC_APP_BASE_URL env var before `docker
# compose build` if you're exposing the stack on a different host/port.
NEXT_PUBLIC_APP_BASE_URL=http://localhost:3000

# Google Gemini (embeddings + review generation)
GOOGLE_GENERATIVE_AI_API_KEY=
